# Адрес OpenAI-совместимого API, без завершающего слэша.
# Пример: https://api.openai.com/v1
# Клиент сам добавит /chat/completions.
VITE_AI_API_URL=

# Ключ этого API. Во frontend он попадает в сборку и не является секретом.
VITE_AI_API_KEY=

# Имя модели у выбранного провайдера. В коде значения по умолчанию нет.
VITE_AI_MODEL=
